    "@stellar/stellar-sdk": "^15.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "bs58": "^6.0.0",
    "bullmq": "^5.63.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^5.8.1",
    "jose": "^6.2.2",
    "mongoose": "^8.18.1",
    "tsc-alias": "^1.8.16",
